# Configurazione API LLM (supporta qualsiasi LLM con formato OpenAI SDK)
# Consigliato: modello Qwen o GPT-4o-mini
# Nota: il consumo può essere elevato, prova prima con poche simulazioni
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Configurazione Memoria ZEP =====
# La quota gratuita mensile supporta bene l'uso semplice: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Configurazione LLM Accelerato (opzionale) =====
# Se non lo usi, non impostare le variabili seguenti in .env
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here